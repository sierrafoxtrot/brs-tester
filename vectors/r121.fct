# R121 NAND / NOR Gate
# This flip-chip functions with open collector outputs

#       AAAAAAAAAAAAAAAAAABBBBBBBBBBBBBBBBBB
#       ABCDEFHJKLMNPRSTUVABCDEFHJKLMNPRSTUV
config='pppOiiOiiOiiiOiiii------------------'

# All combinations
# Gate 1
vector='---011011011101111------------------'
vector='---101011011101111------------------'
vector='---110011011101111------------------'
vector='---100011011101111------------------'
# Gate 2
vector='---011011011101111------------------'
vector='---011101011101111------------------'
vector='---011110011101111------------------'
vector='---011100011101111------------------'
# Gate 3
vector='---011011011101111------------------'
vector='---011011111001111------------------'
vector='---011011110101111------------------'
vector='---011011110001111------------------'
vector='---011011101101111------------------'
vector='---011011101001111------------------'
vector='---011011100101111------------------'
vector='---011011100001111------------------'

# Gate 4
vector='---011011011101111------------------'
vector='---011011011111110------------------'
vector='---011011011111101------------------'
vector='---011011011111100------------------'
vector='---011011011111011------------------'
vector='---011011011111010------------------'
vector='---011011011111001------------------'
vector='---011011011111000------------------'
vector='---011011011110111------------------'
vector='---011011011110110------------------'
vector='---011011011110101------------------'
vector='---011011011110100------------------'
vector='---011011011110011------------------'
vector='---011011011110010------------------'
vector='---011011011110001------------------'
vector='---011011011110000------------------'


# load-* keys are used to define limit values for tests of load networks
# present on some boards. Used when the 'd' operator is found in the config string.
load-low='-3700mV'
load-low-margin='200mV'
load-high='-50mV'
load-high-margin='100mV'
load-current='-1mA'
load-current-margin='2mA'

# input-* keys defined limits when testing inputs
input-current-margin='1mA'

# For a digital '0'
input-voltage-high='-10mV'
input-current-high='-1mA'

# For a digital '1'
input-voltage-low='-3700mV'
input-current-low='0mA'

# Number of times a pin should toggle when the 'T' function is used in the vector string.
toggles='1000'

#             AAAAAAAAAAAAAAAAAABBBBBBBBBBBBBBBBBB
#             ABCDEFHJKLMNPRSTUVABCDEFHJKLMNPRSTUV
#             pppOiiOiiOiiiOiiii------------------
output-drive='---L11-11-111-1111------------------'
output-drive='----11L11-111-1111------------------'
output-drive='----11-11L111-1111------------------'
output-drive='----11-11-111L1111------------------'

# output-drives-strength defines how much current the outputs can sink. This is
# a value is what the tester will load the output with.
output-drive-strength='18mA'

# Those two values will define the voltage drop over the transistor compared top ground. First
# the nominal value and then a margin that defines how much the value could diff from that.
# In this example the drop might be ok if it in between 0 .. -300mV. -150 mV +/-150mV
output-voltage-high='-150mV'
output-voltage-margin='100mV'
